{
    "ConnectionStrings": {
        "DefaultConnection": "Server=.;Database=EventManagementSysDB;Trusted_Connection=True;Encrypt=False"

    },


    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Sinks.Seq",
            "Serilog.Enrichers.Thread",
            "Serilog.Enrichers.Process"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithThreadId",
            "WithProcessId"
        ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [Thread:{ThreadId}] [Process:{ProcessId}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/app-.log",
                    "rollingInterval": "Day",
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [Thread:{ThreadId}] [Process:{ProcessId}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "http://localhost:5341"
                }
            }
        ]
    },
    "AllowedHosts": "*",


    "JwtOptions": {
        "Issuer": "https://localhost:7169/",
        "Audience": "https://localhost:7179/",
        "DurationInHourse": 2
    },


    "ServerSettings": {
        "BaseUrl": "https://localhost:7169/"
    },

    "EmailSettings": {
        "SmtpHost": "smtp.gmail.com",
        "SmtpPort": 587,
        "SmtpUseSSL": true,
        "FromName": "Event Management System"
    },

    "Stripe": {
        "SuccessUrl": "https://localhost:7000/payment/success",
        "CancelUrl": "https://localhost:7000/payment/cancel"
    },

    "ReminderSettings": {
        "HoursBeforeEvent": 24
    },

    "Authentication": {
        "Google": {
            "ClientId": "834763749389-sdfnq07f8gvfl89hjc47v7n39pj20pcf.apps.googleusercontent.com"
        }
    },


